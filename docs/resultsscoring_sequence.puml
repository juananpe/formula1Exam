@startuml "Formula 1 - Race Results Scoring Use Case"

' Styling
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam sequenceParticipant underline

' Participants
actor "User" as user
participant "ResultsController" as controller
participant "BusinessLogic" as bl
participant "DbAccessManager" as db
database "Database" as database
entity "RaceResult" as result

' Sequence
user -> controller : Select Race from Dropdown
activate controller
controller -> bl : getAllRaces()
activate bl
bl -> db : getAllRaces()
activate db
db -> database : query races
activate database
database --> db : races list
deactivate database
db --> bl : races list
deactivate db
bl --> controller : races list
deactivate bl
controller --> user : display races in dropdown
deactivate controller

user -> controller : Click "Load Drivers" button
activate controller
controller -> bl : getRaceResults(selectedRace)
activate bl
bl -> db : getRaceResults(selectedRace)
activate db
db -> database : query race results
activate database
database --> db : results list (if any)
deactivate database
db --> bl : results list
deactivate db
bl --> controller : results list
deactivate bl

alt existing results found
  controller -> controller : populate table with existing results
else no existing results
  controller -> bl : get race drivers
  activate bl
  bl --> controller : drivers list
  deactivate bl
  controller -> controller : initialize position/points to 0
end

controller --> user : display drivers in table
deactivate controller

user -> controller : Edit driver positions and points
activate controller
controller -> controller : update internal maps
controller --> user : enable Save button
deactivate controller

user -> controller : Click "Save Results" button
activate controller
controller -> controller : validate positions and points
controller -> bl : saveRaceResult(race, driver, position, points) [for each driver]
activate bl
bl -> result ** : create new RaceResult
bl -> db : saveRaceResult(result)
activate db
db -> database : persist result
activate database
database --> db : confirmation
deactivate database
db -> db : updateDriverPoints(driver, points)
db --> bl : success
deactivate db
bl --> controller : success
deactivate bl
controller --> user : show success message
deactivate controller

@enduml 