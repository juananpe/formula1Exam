@startuml
title Formula 1 Results Scoring Sequence Diagram
actor User
participant "UI Results" as RC
participant "BlInterface" as BL
participant "DbAccessManager" as DB
participant "EntityManager" as EM
participant "Pilot" as P
participant "Race" as R
participant "RaceResult" as RR

== Initialization ==
RC -> BL: getAllRaces()
BL -> DB: getAllRaces()
DB -> EM: createQuery(q1)
note right of EM
  q1 = "SELECT r FROM Race r"
end note
EM --> DB: List<Race>
DB --> BL: List<Race>
RC -> RC: Initialize UI components and\npopulate race comboBox

== Race Selection ==
User -> RC: Select race from comboBox
User -> RC: Click loadDriversButton
RC -> BL: getRaceResults(selectedRace)
BL -> DB: getRaceResults(selectedRace)
DB -> EM: createQuery(q2)
note right of EM
  q2 = "SELECT rr FROM RaceResult rr 
   WHERE rr.race = :race"
end note
EM --> DB: List<RaceResult>
DB --> BL: List<RaceResult>

alt Existing results found
    RC -> RC: Load drivers, positions/points
    RC -> RC: Update table with existing results
else No existing results
    RC -> R: getDrivers()
    R --> RC: List<Pilot>
    RC -> RC: Initialize positions/points to default values
    RC -> RC: Update table with participating drivers
end

== Position and Points Assignment ==
loop for each driver to edit
    User -> RC: Edit position cell in table
    RC -> RC: Update positionsMap
    User -> RC: Edit points cell in table
    RC -> RC: Update pointsMap
end

== Save Race Results ==
User -> RC: Click saveResultsButton
RC -> RC: Validate positions and points
alt Validation fails
    RC -> RC: Create alert dialog with error message
else Validation passes
    loop for each driver
        alt driver in existing race results
            RC -> BL: updateRaceResult(existingResult, position, points)
            BL -> DB: updateRaceResult(result, position, points)
            DB -> EM: getTransaction().begin()
            DB -> RR: setPosition(position)
            DB -> RR: setPoints(points)
            DB -> P: addPoints(pointsDiff)
            DB -> EM: getTransaction().commit()
        else new driver result
            RC -> BL: saveRaceResult(selectedRace, driver, position, points)
            BL -> RR: new RaceResult(race, driver, position, points)
            BL -> DB: saveRaceResult(result)
            DB -> EM: getTransaction().begin()
            DB -> EM: persist(result)
            DB -> P: addPoints(points)
            DB -> EM: getTransaction().commit()
        end
    end
    BL --> RC: success
    RC -> RC: Create success alert dialog
end

@enduml