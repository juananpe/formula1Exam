<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.presentation.RacesController">
   <children>
      <TableView fx:id="tableRaces" layoutX="51.0" layoutY="53.0" prefHeight="292.0" prefWidth="475.0">
         <columns>
            <TableColumn fx:id="nameColumn" prefWidth="237.5" text="Race Name" />
            <TableColumn fx:id="dateColumn" prefWidth="237.5" text="Date" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label layoutX="51.0" layoutY="23.0" text="Formula 1 Races">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <Label layoutX="51.0" layoutY="365.0" text="Number of Races:" />
      <Label fx:id="numRaces" layoutX="160.0" layoutY="365.0" text=" " />
   </children>
</AnchorPane>
